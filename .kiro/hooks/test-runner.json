{
  "name": "Run Tests on Save",
  "description": "Automatically runs relevant tests when code files are saved",
  "trigger": {
    "type": "onSave",
    "filePattern": "src/**/*.{js,jsx}"
  },
  "actions": [
    {
      "type": "runCommand",
      "command": "npm test -- --run --reporter=verbose"
    }
  ],
  "enabled": true
}
